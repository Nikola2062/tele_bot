# Environment Configuration
# Telegram bot token from @BotFather (shared across the whole Telegram Hub)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here

# Optional: bot username for log output (derived via getMe() if unset)
# BOT_USERNAME=my_news_bot

# Data directory for the SQLite cache and the parcel registry.
# When started via `python main.py` these are pinned to the hub ./data folder.
DATA_DIR=./data
# DATABASE_PATH=./data/cache.db
# PARCELS_FILE=./data/parcels.json

# Optional: Customize news sources (comma-separated)
# DEFAULT_SOURCES=zhihu,weibo,toutiao,baidu,hackernews,github
DEFAULT_SOURCES=zhihu,weibo,toutiao,baidu

# Optional: Customize notification frequency (cron format)
# Default: every hour at minute 0
NOTIFICATION_CRON=0 * * * *

# Optional: Maximum news items per notification
MAX_NEWS_PER_SOURCE=5

# Optional: News sources configuration
NEWS_TIMEOUT=10000
NEWS_RETRY_COUNT=3

# Logging level
LOG_LEVEL=info
