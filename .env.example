# ===== Telegram Hub — shared environment =====
# Copy to .env and fill in. This one file feeds all three services.

# One bot token for the whole hub (from @BotFather).
# Only the `bot` service long-polls; dhl + papers just send messages with it.
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token-here

# DHL Shipment Tracking API key (https://developer.dhl.com — free tier: 250 calls/day)
DHL_API_KEY=your-dhl-api-key-here

# ----- LLM for paper summaries: set ONE of the two keys -----
# Option A: OpenRouter (https://openrouter.ai/keys).
# Default model: poolside/laguna-xs-2.1 (append :free for the free tier).
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# Option B: DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# If BOTH keys are set, DeepSeek wins unless you force a provider:
# LLM_PROVIDER=openrouter
# Override the model for either provider:
# LLM_MODEL=poolside/laguna-xs-2.1

# Chat(s) that receive the daily papers digest (comma-separated for several).
# Parcel updates do NOT use this — they go to whichever chat ran /track.
TELEGRAM_CHAT_ID=123456789

# ----- optional tuning -----

# DHL poll times (Europe/Berlin, HH:MM comma-separated). Two polls/day keeps
# even ~100 active parcels inside the free tier.
# DHL_POLL_TIMES=06:00,18:00

# Papers digest schedule (Europe/Berlin; default 10:00)
# SCHEDULE_HOUR=10
# SCHEDULE_MINUTE=0

# Papers selection
# PAPERS_PER_DAY=3
# MIN_UPVOTES=5
# DEEPSEEK_MODEL=deepseek-chat   # legacy DeepSeek-only model override; prefer LLM_MODEL

# News bot logging
# LOG_LEVEL=info
