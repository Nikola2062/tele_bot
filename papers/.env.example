# LLM for summaries — set ONE of the two keys.
# Option A: OpenRouter (https://openrouter.ai/keys), default model poolside/laguna-xs-2.1
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# Option B: DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# If both keys are set, DeepSeek wins unless LLM_PROVIDER=openrouter.
# LLM_PROVIDER=openrouter
# LLM_MODEL=poolside/laguna-xs-2.1        # model override for either provider
# DEEPSEEK_MODEL=deepseek-chat            # legacy DeepSeek-only override

# Telegram bot (create via @BotFather, get chat_id from @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional: how many papers per run (default 3)
PAPERS_PER_DAY=3

# Optional: minimum upvotes for a paper to qualify (default 5)
# MIN_UPVOTES=5

# Optional: daily schedule for --schedule mode (Europe/Berlin, default 10:00)
# SCHEDULE_HOUR=10
# SCHEDULE_MINUTE=0

# Optional: dedup state file (default: <repo>/state/sent_papers.json;
# `python main.py` sets this to ../data/sent_papers.json)
# SENT_PAPERS_FILE=../data/sent_papers.json
